# Copy this to a file on the host, outside the repository, and fill it in.
# Every name below is empty on purpose: this file is the checklist somebody
# works from, and a value in it is a value somebody ships. A test asserts that
# every line here is a bare name followed by `=` and nothing else.
#
# prod.py refuses to start when any of the first nine is missing or empty, and
# scripts/preflight_env.sh checks all of them before anything restarts, because
# a container in a restart loop over a missing variable is an outage that reads
# as a code fault.

# Django's signing key. Generate a fresh one; never reuse a development value.
DJANGO_SECRET_KEY=
# Comma separated hostnames this service answers on, for example ampeer.nl.
DJANGO_ALLOWED_HOSTS=
# Comma separated origins, scheme included. Same origin as the site in this
# setup, so this is the site's own https origin and no wildcard.
DJANGO_CORS_ALLOWED_ORIGINS=
# How many proxies of this deployment's own chain append to X-Forwarded-For.
# Two here: the tunnel connector and nginx. A wrong number makes the rate
# limit bypassable with one header.
DJANGO_NUM_PROXIES=
# Absolute path on the host to the NEDU profile file. It is bind mounted read
# only into the api container, which reads it at /srv/profiles/nedu.csv. The
# file must exist and be readable, or the readiness check reports unhealthy.
AMPEER_NEDU_PROFILE_PATH=
# Postgres. POSTGRES_HOST is the compose service name, so `db`.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=

# The release tag the deploy published, for example v0.1.0. Both images this
# repository builds are pulled at this tag, so it is what a rollback changes.
AMPEER_VERSION=
# The Cloudflare Tunnel connector token. It is a credential: whoever reads this
# file can run a connector for this tunnel, so keep the file readable only by
# the account that runs the stack.
CLOUDFLARE_TUNNEL_TOKEN=
