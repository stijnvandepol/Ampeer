__pycache__/
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
build/
dist/
data/

# Agent skills installed by a tool, not by this project. 138 third-party
# directories and 6.7 MB of them landed here on 2026-09-15 from
# `npx skills add`, and the installer says in its own last line that they run
# with full agent permissions. Code nobody in this repository reviewed does not
# belong in this repository's history.
.agents/

# An environment file anywhere in the tree. `infra/.env.example` is the
# checklist and is committed with every value empty; a filled one holds a
# Django signing key, a database password and a mail API key, and the only
# reason one is ever written here is to be copied to a host and deleted. This
# line is what stops the copy that lives for ten minutes from living forever in
# the history.
.env
*.env
!infra/.env.example
.coverage
coverage.xml
htmlcov/
sbom.json
requirements-*.txt

# The Next.js frontend. node_modules and the build outputs are reproducible
# from frontend/pnpm-lock.yaml; the Playwright report and its traces are run
# artefacts that can hold screenshots of a rendered advice page.
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/playwright-report/
frontend/test-results/

# The barrier's local smoke fixtures. Generated by tests/test_stack_smoke.py
# for infra/compose.test.yml: a megabyte of synthetic profile numbers and an
# env file shaped exactly like the one that holds the signing key on the host.
# Neither belongs in a repository, and the second one is the shape somebody
# edits into a real one.
infra/fixtures/

# Scratch output from a Playwright MCP browser session. Never part of the tree.
.playwright-mcp/
